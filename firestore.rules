rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isPsicologo() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "psicologo";
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, create, update: if isPsicologo();
    }
    
    match /users/{userId}/chat_history/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, create: if isPsicologo();
    }
    
    match /emergency_alerts/{alertId} {
      allow create: if true; 
      allow read, update, delete: if isPsicologo();
    }

    match /resources/{resourceId} {
      allow read: if true; 
      allow write: if isPsicologo();
    }
  }
}
